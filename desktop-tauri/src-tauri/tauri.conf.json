{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "t-line",
  "version": "1.3.652",
  "identifier": "com.tline.manager",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5773",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "t-line Workspace Manager",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../backend/package.json",
      "../backend/dist/**/*",
      "../backend/node_modules/**/*",
      "../frontend/dist/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/RudyCity/t-line/releases/latest/download/updater.json"
      ],
      "pubkey": "dW51c2VkX3BsYWNlaG9sZGVyX2tleV9mb3JfZGV2X29ubHk="
    }
  }
}
