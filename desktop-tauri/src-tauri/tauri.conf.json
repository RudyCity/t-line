{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "t-line",
  "version": "1.3.723",
  "identifier": "com.tline.manager",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5773",
    "beforeDevCommand": "bun run copy-assets && bun --cwd ../frontend dev",
    "beforeBuildCommand": "bun run copy-assets && bun --cwd ../frontend build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "t-line Workspace Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:* http://localhost:* ws://127.0.0.1:* http://127.0.0.1:* tauri://localhost https://tauri.localhost; frame-src 'self' data: blob:; object-src 'self' data: blob:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "T-Line Workspace Manager",
    "longDescription": "T-Line is the desktop version of SuperAgent, an interactive AI coding assistant.",
    "resources": {
      "../backend/dist/": "backend/dist/",
      "../backend/node_modules/": "backend/node_modules/",
      "../backend/package.json": "backend/package.json",
      "../bun-runtime/": "bun-runtime/"
    }
  },
  "plugins": {
    "shell": {
      "open": {
        "urlPrefixes": [
          "https://",
          "http://"
        ]
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/RudyCity/t-line/releases/latest/download/updater.json"
      ],
      "pubkey": ""
    }
  }
}
