{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "t-line",
  "version": "1.3.675",
  "identifier": "com.tline.manager",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5773",
    "beforeDevCommand": "bun run copy-assets && bun --cwd ../frontend dev",
    "beforeBuildCommand": "bun run copy-assets && bun --cwd ../frontend build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "t-line Workspace Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
