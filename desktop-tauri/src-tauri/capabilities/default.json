{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "browser-*"
  ],
  "webviews": [
    "main",
    "browser-*"
  ],
  "remote": {
    "urls": [
      "http://localhost:*/**",
      "https://localhost:*/**",
      "http://127.0.0.1:*/**",
      "https://127.0.0.1:*/**"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-start-dragging",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-create-webview",
    "core:webview:allow-webview-close",
    "core:window:allow-create",
    "core:webview:allow-set-webview-position",
    "core:webview:allow-set-webview-size",
    "core:webview:allow-webview-hide",
    "core:webview:allow-webview-show",
    "core:webview:allow-internal-toggle-devtools",
    "allow-quit-app",
    "allow-start-backend-command",
    "allow-get-app-url",
    "allow-open-webview-devtools",
    "allow-eval-webview-js",
    "allow-create-detached-window",
    "allow-close-detached-window",
    "allow-get-memory-usage",
    "allow-focus-window",
    "allow-check-tauri-update",
    "allow-install-tauri-update"
  ]
}
