{
  "name": "t-line-root",
  "version": "1.3.299",

  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "desktop",
    "desktop-tauri"
  ],
  "scripts": {
    "dev:backend": "node dev.js backend",
    "dev:frontend": "node dev.js frontend",
    "dev": "node dev.js",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:desktop": "npm run dist --workspace=desktop",
    "build:exe": "npm run build:frontend && npm run build:backend && npm run build:desktop",
    "desktop": "npm run start --workspace=desktop",
    "tauri": "npm run tauri dev --workspace=desktop-tauri",
    "dev:tauri": "npm run tauri dev --workspace=desktop-tauri",
    "build:tauri": "npm run build:frontend && npm run build:backend && npm run copy-assets --workspace=desktop-tauri && npm run tauri build --workspace=desktop-tauri",
    "test:frontend": "npm run test --workspace=frontend",
    "test": "npm run test:frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

