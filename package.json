{
  "name": "t-line-root",
  "version": "1.3.538",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "desktop-tauri"
  ],
  "scripts": {
    "dev:backend": "node dev.js backend",
    "dev:frontend": "node dev.js frontend",
    "dev": "node dev.js",
    "build:backend": "bun run --filter backend build",
    "build:frontend": "bun run --filter frontend build",
    "build:exe": "bun run build:tauri",
    "tauri": "node dev.js tauri",
    "dev:tauri": "node dev.js tauri",
    "build:tauri": "bun run build:frontend && bun run build:backend && bun run --filter desktop-tauri copy-assets && bun run --filter desktop-tauri tauri build",
    "test:frontend": "bun run --filter frontend test",
    "test": "bun run test:frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
