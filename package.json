{
  "name": "t-line-root",
  "version": "1.3.292",

  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "desktop"
  ],
  "scripts": {
    "dev:backend": "node dev.js backend",
    "dev:frontend": "node dev.js frontend",
    "dev": "node dev.js",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:desktop": "npm run dist --workspace=desktop",
    "build:exe": "npm run build:frontend && npm run build:backend && npm run build:desktop",
    "desktop": "npm run start --workspace=desktop",
    "test:frontend": "npm run test --workspace=frontend",
    "test": "npm run test:frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

