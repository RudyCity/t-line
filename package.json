{
  "name": "superagent",
  "version": "1.3.749",
  "description": "Interactive terminal-based AI coding assistant",
  "type": "module",
  "bin": {
    "superagent": "./dist/cli.js"
  },
  "workspaces": [
    "backend",
    "frontend",
    "desktop-tauri"
  ],
  "scripts": {
    "dev": "bun src/cli.tsx",
    "dev:backend": "bun dev.cjs backend",
    "dev:frontend": "bun dev.cjs frontend",
    "dev:tauri": "bun dev.cjs tauri",
    "build:backend": "bun run --filter backend build",
    "build:frontend": "bun run --filter frontend build",
    "build:tauri": "bun run build:frontend && bun run build:backend && bun run --filter desktop-tauri copy-assets && bun scripts/run-tauri-build.cjs",
    "studio:release-check": "bun scripts/check-studio-release.cjs",
    "studio:release-gate": "bun scripts/check-studio-release.cjs --strict",
    "build:exe": "bun run build:tauri",
    "sync:version": "bun scripts/sync-version.cjs",
    "prebuild": "bun scripts/sync-version.cjs",
    "build": "bun --bun x tsc",
    "start": "bun dist/cli.js",
    "test": "cd frontend && bun --bun x vitest run --config vite.config.ts && cd .. && bun --bun x vitest run --environment node tests/auth.test.ts tests/superAgentRuntime.test.ts tests/superAgentParityBridge.test.ts tests/superAgentPortProbe.test.ts tests/superAgentTaskEvents.test.ts tests/superAgentTaskCancel.test.ts tests/superAgentTaskRetry.test.ts",
    "parity:sync": "bun scripts/audit-superagent-parity.cjs",
    "parity:check": "bun scripts/audit-superagent-parity.cjs --check",
    "verify:extension-js": "bun scripts/verify-extension-js.mjs",
    "verify:all": "bun run build && bun run verify:extension-js && bun run test",
    "ext:css": "tailwindcss -i chrome-extension/sidepanel.src.css -o chrome-extension/sidepanel.css",
    "ext:css:watch": "tailwindcss -i chrome-extension/sidepanel.src.css -o chrome-extension/sidepanel.css --watch",
    "postinstall": "bun --bun x patch-package",
    "tauri": "bun --cwd desktop-tauri tauri"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/google": "^1.2.22",
    "@ai-sdk/openai": "^1.3.23",
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@modelcontextprotocol/sdk": "^1.4.0",
    "@napi-rs/canvas": "^1.0.2",
    "@types/pdf-parse": "^1.1.5",
    "@xenova/transformers": "^2.17.2",
    "ai": "^4.3.16",
    "execa": "^9.5.2",
    "fast-glob": "^3.3.3",
    "ink": "^5.2.0",
    "ink-text-input": "^6.0.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "r-memory": "git+https://github.com/RudyCity/r-memory.git",
    "react": "^18.3.1",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1",
    "tiktoken": "^1.0.22",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "@types/node": "^22.15.2",
    "@types/react": "^18.3.20",
    "@types/ssh2": "^1.15.5",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
